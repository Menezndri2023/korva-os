# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3001
# Comma-separated list of allowed browser origins — never reflect an arbitrary Origin
# with credentials:true (see docs/security.md).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- apps/web (Next.js, exposed to the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public base URL of apps/storefront for this deployment — used to build the "view my public
# page" link and the embeddable widget snippet in Settings > Mon site existant.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

# --- Database ---
MONGODB_URI=mongodb://korva:korva@localhost:27017/korva?authSource=admin&replicaSet=rs0

# --- Redis / Queues ---
# Port 6380 on the host to avoid clashing with another local Redis on 6379 (see docker-compose.yml)
REDIS_URL=redis://localhost:6380

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_REFRESH_TTL=30d

# --- Integrations (IntegrationAccount credential store — see docs/architecture/integrations-platform.md) ---
# Dedicated AES-256-GCM key for encrypting stored PSP/WhatsApp credentials, deliberately separate
# from JWT_SECRET so rotating one never silently corrupts the other. Placeholder only.
INTEGRATION_CREDENTIALS_KEY=change-me-in-production

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Email ---
# When RESEND_API_KEY is empty, CommunicationModule falls back to a log-only provider
# (no email actually sent) — see docs/architecture-decisions.md ADR-007.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@korva.app
# Signing secret for Resend's delivery-status webhook (Dashboard > Webhooks > Signing Secret,
# format "whsec_..."). Required for POST /api/v1/webhooks/resend to accept events — see
# apps/api/src/communication/webhooks/resend-webhook.controller.ts for the current limitation
# (raw-body capture needs a one-line main.ts change not yet made this wave).
RESEND_WEBHOOK_SECRET=

# --- Payments ---
STRIPE_SECRET_KEY=
CINETPAY_API_KEY=
# Also used to verify Paystack webhook signatures (x-paystack-signature, HMAC-SHA512) — unlike
# Flutterwave, Paystack signs webhooks with this SAME key, not a separate webhook-only secret. See
# PaystackWebhookController's own doc comment for the single-platform-secret assumption this implies.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Flutterwave's webhook authenticity secret ("secret hash" in their dashboard) — a static value
# they echo back verbatim in the `verif-hash` header on every webhook call (NOT an HMAC; see
# FlutterwaveWebhookVerifier for why). Distinct from FLUTTERWAVE_SECRET_KEY above: that key
# authenticates KORVA calling Flutterwave's API, this one authenticates Flutterwave calling back
# to KORVA. Missing this fails the webhook closed (503), never accepts an unverified call.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# How often (ms) the background job retries Payments/Refunds stuck in 'processing' against the
# payment provider — see ReconciliationSchedulerService. Optional: defaults to 300000 (5 min).
PAYMENT_RECONCILIATION_INTERVAL_MS=300000

# --- AI ---
# When AI_API_KEY is empty, AiModule falls back to a "not configured" no-op provider
# (no LLM actually called, no tool ever runs) — see docs/ai.md.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Messaging ---
# DEV/TEST-ONLY GLOBAL BINDING — NOT the production WhatsApp path (Stage 2.4). Every real,
# tenant-scoped WhatsApp send (ConversationsService, the AI send_whatsapp tool) now resolves its
# provider through MessagingProviderResolverService.resolveTenantProvider(organizationId, ...),
# which reads each tenant's OWN encrypted IntegrationAccount credential and fails closed
# (WHATSAPP_NOT_CONNECTED) if that tenant hasn't connected one — it never falls back to these two
# variables. MESSAGING_PROVIDER/WHATSAPP_API_KEY only control MessagingProviderModule's separate,
# process-wide MESSAGING_PROVIDER DI token, which nothing in the real send path injects anymore
# (see conversations.service.ts's own Stage 2.4 comment) — kept only as an available binding for a
# future non-tenant/system-level use case, never as a way to bypass per-tenant credential
# resolution. When MESSAGING_PROVIDER=360dialog and WHATSAPP_API_KEY is set, that DI token
# constructs a real ThreeSixtyDialogProvider; otherwise it falls back to a log-only provider —
# same pattern as EMAIL_PROVIDER/RESEND_API_KEY above.
MESSAGING_PROVIDER=
WHATSAPP_API_KEY=
# 360dialog's own webhook-signing "platform secret" (HMAC-SHA256 over the raw body, header
# x-360dialog-signature) — distinct from WHATSAPP_API_KEY, generated in the 360dialog Hub. See
# ThreeSixtyDialogWebhookVerifier for why this is 360dialog's own scheme, not Meta's
# X-Hub-Signature-256.
THREESIXTYDIALOG_WEBHOOK_SECRET=
# Only needed if 360dialog (or a future direct Meta Tech Provider registration) performs Meta's
# GET hub.mode/hub.verify_token/hub.challenge handshake against this webhook URL.
THREESIXTYDIALOG_WEBHOOK_VERIFY_TOKEN=

# --- Error tracking (Sentry) ---
# When SENTRY_DSN is empty, the API boots and runs exactly as if Sentry didn't exist — no
# init, no network calls (see apps/api/src/core/observability/sentry.ts). Optional in every
# environment; strongly recommended in production for 5xx/unhandled-exception visibility.
SENTRY_DSN=
# Defaults to NODE_ENV when unset.
SENTRY_ENVIRONMENT=
# Defaults to apps/api/package.json's "version" when unset.
SENTRY_RELEASE=
