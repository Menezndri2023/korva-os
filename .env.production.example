# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#
# .env.production is gitignored by .gitignore's `.env*` rule, which this file's own name escapes
# through an explicit negation. Never commit a filled copy: every value below is either a secret
# or a secret's address.
#
# The six variables under "Required" are enforced by apps/api/src/core/config/env.validation.ts
# — the API refuses to boot without them, by design. Everything else has a safe fallback, which
# in practice means the corresponding feature is inert rather than broken (an unset
# RESEND_API_KEY logs instead of sending, for example).

# === Required: the API will not start without these ==========================

# Managed MongoDB. A REPLICA SET is mandatory, not a recommendation: Payment/Invoice and
# Order/Cart writes use multi-document transactions, which MongoDB only supports on a replica
# set. A single-node mongod will start, serve reads, and then fail every financial write.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/korva?retryWrites=true&w=majority

# Managed Redis. Backs BullMQ (12 queues) and rate limiting.
REDIS_URL=rediss://default:PASSWORD@redis.example.com:6380

# Staff dashboard auth. Generate each INDEPENDENTLY — reusing one value for both means a leaked
# access token is also a valid refresh token:
#   openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Storefront customer-portal auth. A THIRD, distinct secret: it must never be interchangeable
# with the staff secrets, or a customer token would authenticate against the dashboard.
CUSTOMER_JWT_SECRET=

# AES-256-GCM key encrypting stored integration credentials (PSP keys, messaging tokens) at
# rest. Rotating this makes every already-stored credential undecryptable — plan a re-entry pass
# before you change it.
#   openssl rand -hex 32
INTEGRATION_CREDENTIALS_KEY=

# === Public addresses ========================================================
# Must match the hostnames in docker/caddy/Caddyfile and the DNS records pointing at this host.

DASHBOARD_DOMAIN=app.example.com
API_DOMAIN=api.example.com
STOREFRONT_DOMAIN=sites.example.com
ACME_EMAIL=ops@example.com

# Baked into the web/storefront CLIENT bundles at BUILD time (Next.js inlines NEXT_PUBLIC_*).
# Changing it requires rebuilding those images, not just restarting them.
PUBLIC_API_URL=https://api.example.com/api/v1

# Server-side equivalents, read at runtime by the API.
APP_URL=https://app.example.com
API_URL=https://api.example.com
STOREFRONT_URL=https://sites.example.com

# Browsers are refused any origin not listed here. Tenant custom domains do NOT belong in this
# list — they reach the storefront, which calls the API server-side, not from the browser.
CORS_ORIGINS=https://app.example.com,https://sites.example.com

# === Optional: each unset value leaves its feature inert, never broken =======

NODE_ENV=production

# Transactional email (password reset, email verification, invites). Unset: the API logs the
# message instead of sending it, so an account can be created but its owner never gets the link.
# Configure SPF, DKIM and DMARC for EMAIL_FROM's domain, or expect spam folders.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Error tracking. Unset: exceptions are logged locally only (see core/observability/sentry.ts).
SENTRY_DSN=

# Requires `Authorization: Bearer <token>` on GET /metrics. The Caddyfile also blocks that route
# at the edge, so leave this set only if your scraper is outside the private network.
METRICS_TOKEN=

# Object storage for uploads (logos, images). Unset: files go to local disk inside the
# container, which means they vanish on redeploy.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI assistant. Unset: AI routes return a typed "not configured" error.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Payment providers are NOT configured here. They are stored per market as encrypted platform
# IntegrationAccounts (see scripts/create-platform-integration-account.ts and
# docs/architecture/integrations-platform.md §4) — one for KORVA's own subscription billing
# (role: subscription-billing) and one per tenant market (role: merchant-of-record). The legacy
# STRIPE_SECRET_KEY/CINETPAY_API_KEY/PAYSTACK_SECRET_KEY/FLUTTERWAVE_SECRET_KEY variables in
# .env.example are unread by any code path.

# Scheduler intervals, in ms. Defaults are sensible; override only with a reason.
# SUBSCRIPTION_PERIOD_INTERVAL_MS=900000
# Days a tenant has to pay a SubscriptionInvoice before the subscription goes past_due.
# SUBSCRIPTION_INVOICE_GRACE_DAYS=7
