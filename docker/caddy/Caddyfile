# TLS termination and host-based routing for KORVA.
#
# Three fixed hostnames (dashboard, API, the platform's shared storefront domain) plus any
# number of tenant custom domains, which are added at RUNTIME and therefore cannot be listed
# here. Those are handled by on-demand TLS below.

{
	email {$ACME_EMAIL}

	on_demand_tls {
		# Caddy calls this before issuing a certificate for a hostname it does not already have,
		# appending ?domain=<hostname>. The API answers 204 only for a domain genuinely connected
		# to a website-enabled organization, and 404 otherwise (see PublicController#domainAllowed).
		#
		# This endpoint is what makes on-demand TLS safe. Without it, anyone could point a DNS
		# record at this host and make Caddy request a certificate on their behalf, exhausting the
		# ACME rate limit for the whole deployment within minutes.
		# This is the ONLY protection, so the endpoint carries the whole weight. Caddy removed
		# the `interval`/`burst` rate limits from `on_demand_tls` (it refuses to start if they
		# are present, which is how this was found), on the reasoning that a rate limit cannot
		# distinguish an attack from a busy launch day while `ask` can answer definitively.
		ask http://api:4000/api/v1/public-sites/domain-allowed
	}
}

# --- Dashboard ---------------------------------------------------------------
{$DASHBOARD_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# --- Bare domain and www ------------------------------------------------------
# korvasuite.com / www.korvasuite.com: the landing page lives on the dashboard's "/", so both send
# visitors there, keeping the path. Without this block they fell into the tenant catch-all below,
# whose `ask` (rightly) refuses a domain no shop owns — so the bare domain could never get a
# certificate. Their DNS A records must point at this host too, proxy OFF.
{$MARKETING_DOMAIN}, www.{$MARKETING_DOMAIN} {
	redir https://{$DASHBOARD_DOMAIN}{uri} permanent
}

# --- API ---------------------------------------------------------------------
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000

	# Both of these expose the same thing — every queue's name and its job counts — and both are
	# @Public() because a scraper cannot present a tenant JWT. METRICS_TOKEN guards them at the
	# application level (operational-access.ts, which in production denies the route when the
	# token is unset rather than opening it); this blocks them at the edge as well, so a
	# misconfigured token cannot expose them to the internet.
	#
	# /api/v1/health/queues was missing here until 2026-10-14 and answered 200 to anyone, which
	# made this block decorative: it named all thirteen queues and their volumes, and every
	# anonymous request fanned out to one getJobCounts per queue. If you add a route that returns
	# operational state, it belongs in this list.
	#
	# /health, /health/database and /health/redis stay reachable on purpose — an uptime monitor
	# needs them and each reveals a single bit.
	#
	# Delete these only if a scraper genuinely lives outside the private network, and set
	# METRICS_TOKEN if you do.
	@operational path /api/v1/metrics /api/v1/health/queues
	respond @operational 404

	# The on-demand-TLS `ask` endpoint is called by Caddy over the internal network and must never
	# be reachable from outside: a public caller could enumerate which custom domains are
	# configured, one guess at a time.
	@domain_ask path /api/v1/public-sites/domain-allowed
	respond @domain_ask 404
}

# --- Platform storefront domain ----------------------------------------------
{$STOREFRONT_DOMAIN} {
	encode zstd gzip
	reverse_proxy storefront:3000
}

# --- Tenant custom domains ---------------------------------------------------
# Catch-all for every hostname not matched above. Reached only after `ask` approved the
# certificate, so an unapproved domain never gets this far. The storefront's own middleware then
# resolves the Host header to a tenant via GET /public/resolve-domain.
:443 {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy storefront:3000
}
