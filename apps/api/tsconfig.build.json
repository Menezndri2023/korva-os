{
  "extends": "./tsconfig.json",
  // `rootDir` is pinned, never inferred. tsc derives it from the common parent of every input
  // file, so adding one `.ts` outside `src/` silently moves the entire output tree: once
  // `apps/api/scripts/` existed, the root became `apps/api/` and the entrypoint landed at
  // `dist/src/main.js` — while `apps/api/Dockerfile` still runs `node dist/main.js`. The
  // production API image could not start, and nothing caught it: `pnpm typecheck` runs
  // `tsc --noEmit` against tsconfig.json, which emits nothing and so never reveals the layout.
  //
  // `scripts/` is excluded from the BUILD for the same reason, plus one of its own: those are
  // deploy-time CLI tools run with ts-node against a checkout, and have no business inside a
  // production image. They stay fully typechecked — `pnpm typecheck` uses tsconfig.json, which
  // includes them.
  "compilerOptions": {
    "rootDir": "src",
    // Kept INSIDE dist so nest-cli's `deleteOutDir` removes it with the output it describes.
    // At the package root (tsc's default) it survives `rm -rf dist`, and the next build then
    // emits only what changed — leaving a dist missing most of the application, including
    // main.js. Same root cause as the .dockerignore entry for *.tsbuildinfo.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
